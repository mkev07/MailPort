{
  "name": "mailport",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "apps/vault"
  ],
  "scripts": {
    "check": "npm run check --workspace @mailport/sdk && npm run check --workspace @mailport/vault && npm run build --workspace @mailport/vault",
    "test": "npm test --workspace @mailport/sdk",
    "build": "npm run build --workspaces",
    "vault:dev": "npm run tauri --workspace @mailport/vault -- dev",
    "vault:build": "npm run tauri --workspace @mailport/vault -- build",
    "check:rust": "cargo test -p mailport-core",
    "check:compatibility": "npm run build --workspace @mailport/sdk && node scripts/check-compatibility.mjs",
    "check:session": "cargo test -p mailport --lib vault::tests"
  }
}
