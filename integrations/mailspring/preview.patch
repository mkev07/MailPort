+  keys['sample@example.com-smtp'] = 'wrong';
+  assert.equal(await verifyMailPortAccount(source, 'id', read, decrypt), false);
+  keys['sample@example.com-smtp'] = 'synthetic-out';
+  config['*'].accounts[0].settings.imap_allow_insecure_ssl = true;
+  assert.equal(await verifyMailPortAccount(source, 'id', read, decrypt), false);
+  await assert.rejects(verifyMailPortAccount(source, 'id', async () => { throw new Error('unreadable'); }, decrypt));
