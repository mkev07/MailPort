+++ b/app/internal_packages/onboarding/specs/mailport-adapter.test.ts
@@ -0,0 +1,138 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createMailPortAdapter } from '../lib/mailport-adapter';
+import { hasMailPortCredentialCollision, verifyMailPortAccount } from '../lib/mailport-verify';
+import { createMailPortJournal } from '../lib/mailport-journal';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const journal = () => ({ begin() {}, complete() {} });
+
+const sample = () => ({
+  email: 'sample@example.com', displayName: 'Sample',
+  incoming: { host: 'imap.example.com', port: 993, username: 'in', security: 'tls', auth: { type: 'password', password: 'synthetic-in' } },
+  outgoing: { host: 'smtp.example.com', port: 587, username: 'out', security: 'starttls', auth: { type: 'password', password: 'synthetic-out' } },
+});
+function fixture(existing = []) {
+  const saved = [];
+  return { saved, adapter: createMailPortAdapter({
+    accounts: () => existing,
+    makeAccount: (data) => data,
+    save: async (account) => { saved.push(account); },
+    verify: async () => true,
+    preflight: async () => false,
+    journal: journal(),
+    idForAccount: () => 'stable-id',
+  }) };
+}
+test('maps independent credentials and secure server settings', async () => {
+  const { saved, adapter } = fixture();
+  await adapter.upsertAccount(sample());
+  assert.equal(saved.length, 1);
+  assert.equal(saved[0].settings.imap_password, 'synthetic-in');
+  assert.equal(saved[0].settings.smtp_password, 'synthetic-out');
+  assert.equal(saved[0].settings.imap_security, 'SSL / TLS');
+  assert.equal(saved[0].settings.smtp_security, 'STARTTLS');
+  assert.equal(saved[0].settings.imap_allow_insecure_ssl, false);
+});
+test('refuses existing accounts and OAuth without saving', async () => {
+  const duplicate = fixture([{ id: 'other', emailAddress: 'SAMPLE@example.com' }]);
+  await assert.rejects(duplicate.adapter.upsertAccount(sample()));
+  assert.equal(duplicate.saved.length, 0);
+  const oauth = fixture();
+  const account = sample();
+  account.incoming.auth = { type: 'oauth', password: '' };
+  await assert.rejects(oauth.adapter.upsertAccount(account));
+  assert.equal(oauth.saved.length, 0);
+});
+test('propagates storage failure', async () => {
+  let saves = 0;
+  const adapter = createMailPortAdapter({ accounts: () => [], makeAccount: x => x,
+    save: async () => { saves++; throw new Error('storage unavailable'); }, preflight: async () => false, verify: async () => true, journal: journal(), idForAccount: () => 'id' });
+  await assert.rejects(adapter.upsertAccount(sample()));
+  assert.equal(adapter.hasUncertainSave(), true);
+  await assert.rejects(adapter.upsertAccount(sample()));
+  assert.equal(saves, 1);
+});
+test('treats an unverified save as uncertain and does not retry it', async () => {
+  let saves = 0;
+  const adapter = createMailPortAdapter({ accounts: () => [], makeAccount: x => x,
+    save: async () => { saves++; }, preflight: async () => false, verify: async () => false, journal: journal(), idForAccount: () => 'id' });
+  await assert.rejects(adapter.upsertAccount(sample()));
+  assert.equal(adapter.hasUncertainSave(), true);
+  await assert.rejects(adapter.upsertAccount(sample()));
+  assert.equal(saves, 1);
+});
+test('a pending marker blocks a later adapter and stores no account details', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mailport-journal-test-'));
+  try {
+    let saves = 0;
+    const build = () => createMailPortAdapter({ accounts: () => [], makeAccount: x => x,
+      save: async () => { saves++; throw new Error('ambiguous'); }, preflight: async () => false, verify: async () => true,
+      journal: createMailPortJournal(dir), idForAccount: () => 'id' });
+    await assert.rejects(build().upsertAccount(sample()));
+    await assert.rejects(build().upsertAccount(sample()));
+    assert.equal(saves, 1);
+    assert.equal(fs.readFileSync(path.join(dir, 'mailport-import-pending'), 'utf8'), 'MailPort preview import pending\n');
+  } finally { fs.rmSync(dir, { recursive: true, force: true }); }
+});
+test('a verified save clears its pending marker', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mailport-journal-test-'));
+  try {
+    const adapter = createMailPortAdapter({ accounts: () => [], makeAccount: x => x,
+      save: async () => {}, preflight: async () => false, verify: async () => true, journal: createMailPortJournal(dir), idForAccount: () => 'id' });
+    await adapter.upsertAccount(sample());
+    assert.equal(fs.existsSync(path.join(dir, 'mailport-import-pending')), false);
+  } finally { fs.rmSync(dir, { recursive: true, force: true }); }
+});
+test('restores the pending marker if syncing its removal fails', () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mailport-journal-test-'));
+  const original = fs.fsyncSync;
+  try {
+    const marker = createMailPortJournal(dir);
+    marker.begin();
+    let inject = true;
+    fs.fsyncSync = fd => {
+      if (inject && fs.fstatSync(fd).isDirectory()) { inject = false; throw new Error('synthetic sync failure'); }
+      return original(fd);
+    };
+    assert.throws(() => marker.complete());
+    assert.equal(marker.isPending(), true);
+  } finally {
+    fs.fsyncSync = original;
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+test('refuses orphaned credentials without saving or making a marker', async () => {
+  let saved = false;
+  let marked = false;
+  const adapter = createMailPortAdapter({ accounts: () => [], makeAccount: x => x,
