+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createMailPortAdapter } from '../lib/mailport-adapter';
+
+const sample = () => ({
+  email: 'sample@example.com',
+  displayName: 'Sample',
+  incoming: { host: 'imap.example.com', port: 993, username: 'in', security: 'tls', auth: { type: 'password', password: 'synthetic-in' } },
+  outgoing: { host: 'smtp.example.com', port: 587, username: 'out', security: 'starttls', auth: { type: 'password', password: 'synthetic-out' } },
+});
+
+test('maps both credentials and secure server settings to the save operation', async () => {
+  const saved = [];
+  const adapter = createMailPortAdapter({
+    makeAccount: data => data,
+    save: async account => { saved.push(account); },
+    idForAccount: () => 'stable-id',
+  });
+  await adapter.upsertAccount(sample());
+  assert.equal(saved.length, 1);
+  assert.equal(saved[0].settings.imap_password, 'synthetic-in');
+  assert.equal(saved[0].settings.smtp_password, 'synthetic-out');
+  assert.equal(saved[0].settings.imap_security, 'SSL / TLS');
+  assert.equal(saved[0].settings.smtp_security, 'STARTTLS');
+  assert.equal(saved[0].settings.imap_allow_insecure_ssl, false);
+  assert.equal(saved[0].settings.smtp_allow_insecure_ssl, false);
+});
+
+test('refuses OAuth and propagates an acknowledged save failure', async () => {
+  let attempts = 0;
+  const adapter = createMailPortAdapter({
+    makeAccount: data => data,
+    save: async () => { attempts += 1; throw new Error('Synthetic write failed'); },
+    idForAccount: () => 'stable-id',
+  });
+  const oauth = sample();
+  oauth.incoming.auth.type = 'oauth';
+  await assert.rejects(adapter.upsertAccount(oauth), /Provider sign-in/);
+  assert.equal(attempts, 0);
+  await assert.rejects(adapter.upsertAccount(sample()), /Synthetic write failed/);
+  assert.equal(attempts, 1);
+});
