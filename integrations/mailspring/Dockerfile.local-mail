FROM rust:1-bookworm AS rust
FROM node:22-trixie

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/home/node/.cargo
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang dbus-x11 gnome-keyring xvfb xauth libgtk-3-0t64 libnss3 \
    libasound2t64 libgbm1 libxss1 libsecret-1-0 libpulse0 \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global npm@10.9.8

RUN install -d -o node -g node /work/mailport
WORKDIR /work/mailport
COPY --chown=node:node . .
USER node
RUN npm ci --no-audit && cargo build --locked -p mailport-core --example compatibility
RUN git config --global url.https://github.com/.insteadOf ssh://git@github.com/ \
    && git config --global --add url.https://github.com/.insteadOf git@github.com: \
    && git init /home/node/mailspring \
    && git -C /home/node/mailspring fetch --depth=1 https://github.com/Foundry376/Mailspring.git 0635d327398c8d97255660ae7b0011bf1e3fe4df \
    && git -C /home/node/mailspring checkout --detach FETCH_HEAD \
    && node integrations/mailspring/prepare-preview.mjs /home/node/mailspring
RUN cd /home/node/mailspring && CC=clang CXX=clang++ npm ci --no-audit
