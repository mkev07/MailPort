{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "dragDropEnabled": false,
        "title": "MailPort Vault",
        "width": 1500,
        "height": 1020,
        "center": true,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#171717",
        "backgroundThrottling": "throttle",
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "macos/Assets.car": null,
      "macos/MailPortDocument.icns": null,
      "macos/MailPortRequest.icns": null
    }
  }
}
