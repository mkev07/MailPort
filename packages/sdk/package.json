{
  "name": "@mailport/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source email account portability toolkit.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test test/import.test.ts test/vault.test.ts",
    "demo": "tsx examples/roundtrip.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run demo"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
